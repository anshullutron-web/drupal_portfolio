{{ attach_library('portfoliolite/footer') }}

<div class="footer-wrapper">

  <div class="footer-grid">

    <div class="footer-col footer-about">
      {{ content.footer_left1 }}
    </div>

    <div class="footer-col">
      {{ content.quicklinks }}
    </div>

    <div class="footer-col">
      {{ content.support }}
    </div>

    <div class="footer-col footer-blog">
      {{ content.footer_right2 }}
    </div>

  </div>

  {% if page.footer %}
  <div class="footer-bottom-extreme">
    {{ page.footer }}
  </div>
  {% endif %}

</div>

