{# {{ attach_library('portfoliolite/works') }} #}

<section class="works">

  <div class="works-header">
    <h2>{{ title }}</h2>
    <p>{{ description }}</p>
  </div>

  <div class="works-filter">

    <button class="filter-btn active" data-filter="all">Brand</button>
    <button class="filter-btn" data-filter="design">Design</button>

    <button class="filter-btn grid" data-filter="all">
      <i class="fa fa-th-large"></i>
    </button>

    <button class="filter-btn" data-filter="marketing">Marketing</button>
    <button class="filter-btn" data-filter="graphics">Graphics</button>

  </div>

  <div class="works-grid">

    {% for work in works %}
      <div class="works-item" data-category="{{ work.category|lower }}">

        <div class="works-image" data-image="{{ file_url(work.image) }}">

          <img 
            src="{{ file_url(work.image) }}" 
            alt="{{ work.category }} work"
            loading="lazy"
          >

          <div class="works-overlay">
            <span class="plus">+</span>
          </div>

        </div>

      </div>
    {% endfor %}

  </div>

</section>

<!-- LIGHTBOX -->
<div class="works-lightbox">
  <span class="lightbox-close">&times;</span>
  <span class="lightbox-prev">&#10094;</span>

  <img class="lightbox-image">

  <span class="lightbox-next">&#10095;</span>
</div>