{{ attach_library('portfoliolite/skills') }}
<section class="skills-section">
  <div class="skills-container">
    <div class="skills-left">
      <h2>{{ title }}</h2>
      <div class="skills-text">
        {{ content.body }}
      </div>
      <div class="skills-bars">
        {{ content.field_our_skills_progress_bar }}
      </div>
    </div>
    <div class="skills-right">
      {{ content.field_ourskillsimage }}
    </div>
  </div>
</section>