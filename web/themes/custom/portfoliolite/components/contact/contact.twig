{{ attach_library('portfoliolite/getintouch') }}

<section class="contact">

  <div class="container">

    {# HEADER #}
    <div class="getintouch-header">
      <h2>{{ label }}</h2>
      <div class="getintouch-description">
        {{ content.body }}
      </div>
    </div>

    {# MAIN GRID #}
    <div class="contact-wrapper">

      {# LEFT SIDE FAQ #}
      <div class="getintouch-faq">

        <h3>Do you have any Question about</h3>

        <div class="faq-list">

          {% for item in content.field_faq %}
            {% if item.entity %}

              <div class="faq-item">

                <div class="faq-question">
                  <span>{{ item.entity.field_question.value }}</span>
                  <span class="faq-icon">+</span>
                </div>

                <div class="faq-answer">
                  <p>{{ item.entity.field_answer.value }}</p>
                </div>

              </div>

            {% endif %}
          {% endfor %}

        </div>

      </div>

      {# RIGHT SIDE FORM #}
      <div class="getintouch-form">
        <div class="form-card">
          {{ content.field_webform }}
        </div>
      </div>

    </div>

  </div>

</section>