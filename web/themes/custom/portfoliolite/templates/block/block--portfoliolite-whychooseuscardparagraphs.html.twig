{{ attach_library('portfoliolite/why') }}

<div class="why-right">

  <div class="why-cards">

    {% for item in content.field_secondary_card['#items'] %}
      {% set paragraph = item.entity %}

      <div class="why-card">

        <div class="icon">
          <i class="fas fa-gem"></i>
        </div>

        <h3>{{ paragraph.field_card_title.value }}</h3>

        <p>{{ paragraph.field_card_description.value }}</p>

      </div>

    {% endfor %}

  </div>

</div>