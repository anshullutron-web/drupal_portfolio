<div class="stat-item">

  <div class="stat-icon">
    {{ content.field_stats_icon }}
  </div>

  <div class="stat-number"
       data-count="{{ content.field_stats_number['#items'].0.value }}">
    {{ content.field_stats_number }}
  </div>

  <div class="stat-title">
    {{ content.field_stats_subtitle }}
  </div>

</div>