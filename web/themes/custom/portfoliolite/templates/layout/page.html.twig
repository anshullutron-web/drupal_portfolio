{{ attach_library('portfoliolite/fontawesome') }}
{{ attach_library('portfoliolite/footer') }}

<div class="layout-container">

  {% if page.header_top %}
    {{ page.header_top }}
  {% endif %}

  {# Header component #}
  {% include '@portfoliolite/components/header/header.twig' with {
    logo: page.header,
    menu: page.primary_menu
  } %}

  {% if is_front %}

    {{ page.hero }}

    {% if page.why %}
    <section class="why">
      <div class="why-container">
        {{ page.why }}
      </div>
    </section>
    {% endif %}

    {% if page.about %}
    <section class="about">
      <div class="about-container">
        {{ page.about }}
      </div>
    </section>
    {% endif %}

    {% if page.services %}
    <section class="services-section">
      <div class="services-container">

        <button class="services-prev">
          <i class="fas fa-arrow-left"></i>
        </button>

        <div class="services-slider">
          {{ page.services }}
        </div>

        <button class="services-next">
          <i class="fas fa-arrow-right"></i>
        </button>

      </div>
    </section>
    {% endif %}

    {% if page.skills %}
    <section class="skills">
      <div class="skills-container">
        {{ page.skills }}
      </div>
    </section>
    {% endif %}

    {% if page.stats %}
    <section class="stats-region">
      {{ page.stats }}
    </section>
    {% endif %}

    {% include directory ~ '/components/pricing/pricing.twig' %}

    {% if page.blog %}
    <section class="blog">
      {{ page.blog }}
    </section>
    {% endif %}

    {% if page.subscribe %}
    <section class="subscribe">
      {{ page.subscribe }}
    </section>
    {% endif %}

    {% if page.contact %}
    <section class="contact">
      {{ page.contact }}
    </section>
    {% endif %}

    {% if page.map %}
    <section class="map">
      {{ page.map }}
    </section>
    {% endif %}

  {% else %}

    <main>
      {{ page.content }}
    </main>

  {% endif %}

  {% include directory ~ '/components/footer/footer.twig' %}
  <footer class="site-footer">

  {% if page.footer_first %}
    <div class="footer-top">
      <div class="container">
        {{ page.footer_first }}
      </div>
    </div>
  {% endif %}

  {% if page.footer_second %}
    <div class="footer-bottom">
      <div class="container">
        {{ page.footer_second }}
      </div>
    </div>
  {% endif %}


  {% if page.footer %}
    <div class="footer-bottom-extreme">
      <div class="container">
        {{ page.footer }}
      </div>
    </div>
  {% endif %}

</footer>
</div>